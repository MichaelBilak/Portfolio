# ── Payload CMS ──────────────────────────────────────────────
# Required for /admin. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# SQLite (local default) — file path, or omit to use ./payload.db
DATABASE_URL=file:./payload.db

# PostgreSQL (production / Neon) — use instead of file: URL
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# First admin user (used by npm run payload:seed)
ADMIN_EMAIL=dormup.it@gmail.com
ADMIN_PASSWORD=

# ── Contact form / email ─────────────────────────────────────
GMAIL_USER=dormup.it@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=dormup.it@gmail.com

# Google Sheets — optional lead log
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_JSON=

# ── Security / rate limit (optional) ─────────────────────────
# Cloudflare Turnstile — when both set, contact form requires token
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis — preferred rate limit for serverless
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics (optional) ─────────────────────────────────────
# Also configurable in Admin → SEO Defaults
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
