# ── Supabase (Studio admin + CMS) ────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API → service_role (server only — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Apply schema: run supabase/migrations/001_studio.sql in Supabase SQL Editor
# Create Storage bucket named `media` (public)
# Create first Auth user in Supabase Auth, then set profiles.role = 'owner'
# Seed content: npm run studio:seed

# ── Contact form / email ─────────────────────────────────────
GMAIL_USER=dormup.it@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=dormup.it@gmail.com

# Google Sheets — optional lead log
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_JSON=

# ── Security / rate limit (optional) ─────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics (optional; also editable in Studio → SEO) ──────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
