# Gmail SMTP credentials
# GMAIL_USER      — your Gmail address (e.g. dormup.it@gmail.com)
# GMAIL_APP_PASSWORD — 16-char App Password from Google Account → Security → App Passwords
#                      (requires 2FA enabled on the Gmail account)
GMAIL_USER=dormup.it@gmail.com
GMAIL_APP_PASSWORD=

# Where form submissions are delivered (defaults to dormup.it@gmail.com)
CONTACT_TO_EMAIL=dormup.it@gmail.com

# Google Sheets — audit request log
# GOOGLE_SHEETS_SPREADSHEET_ID — the ID from the spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
# GOOGLE_SHEETS_CREDENTIALS_JSON — the full JSON content of a Google Service Account key file
#   (one line, JSON-stringified). The service account must have Editor access to the sheet.
#   Steps:
#     1. Google Cloud Console → IAM & Admin → Service Accounts → Create service account
#     2. Keys → Add key → JSON → download the file
#     3. Paste the entire JSON content as a single line here
#     4. In Google Sheets → Share → paste the service account email → Editor
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_JSON=
