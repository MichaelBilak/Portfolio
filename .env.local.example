# Secret admin path (obscure URL). Example: /ops-k7m2xq9n4w
# Direct /studio returns 404 when this is set to something else.
NEXT_PUBLIC_STUDIO_PATH=/ops-k7m2xq9n4w

# ── Supabase (Studio admin + CMS) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apply base schema and CRM migrations.
# Buckets: `media` (public website assets), `crm-private` (private case files).
# Verify after migration: npm run studio:check

# ── Contact form / email ─────────────────────────────────────
GMAIL_USER=dormup.it@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=dormup.it@gmail.com

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_JSON=

# ── Optional CRM integrations (disabled when empty) ──────────
CRM_CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
